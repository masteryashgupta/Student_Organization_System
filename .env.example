# ─── Supabase Database (session pooler — the ONE database for this project) ───
# Get the real value from the team lead; never commit the real password.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase extras (for reference / future client-side use — NOT read by Django)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─── Django Configuration ─────────────────────────────────────────────────────
SECRET_KEY=<generate-a-strong-secret-key>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── JWT Settings ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Frontend Configuration ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
