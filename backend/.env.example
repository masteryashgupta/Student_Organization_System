# ---- Core ----
SECRET_KEY=change-me-in-production-please
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Database ----
# Leave DATABASE_URL blank to use SQLite (zero setup, runs instantly).
# To use Supabase / Postgres, paste the connection string here, e.g.:
# DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# ---- CORS (React dev server) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Payments ----
# PAYMENT_PROVIDER = "mock" (default, no account needed) or "razorpay"
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (announcements / mailing list) ----
# EMAIL_BACKEND_MODE = "console" (prints to terminal) or "smtp"
EMAIL_BACKEND_MODE=console
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@skyline.club
